---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { CATEGORIES } from '../data/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const visibleCategories = CATEGORIES.map(category => ({
  category,
  count: posts.filter(post => post.data.category === category.name).length,
  subcategories: category.subcategories.map(subcategory => ({
    ...subcategory,
    count: posts.filter(post => post.data.category === category.name && post.data.subcategory === subcategory.name).length,
  })).filter(subcategory => subcategory.count > 0),
})).filter(item => item.count > 0);
---
<BaseLayout>
  <section class="hero container">
    <div>
      <p class="eyebrow">Java · Spring · Backend Engineering</p>
      <h1>현상을 재현하고,<br /><em>해결 과정</em>을 기록합니다.</h1>
    </div>
    <div class="intro"><p>Java/Spring 백엔드 개발자<br />문제 해결과 성장의 기록입니다.</p><div><a class="primary-link" href="/categories">주제별로 시작하기 →</a><a href="/about">블로그 소개</a></div></div>
  </section>

  <section class="container explore">
    <div class="section-head">
      <div><p class="eyebrow">Explore by topic</p><h2>주제별로 탐색하기</h2></div>
      <a href="/categories">모든 주제 보기 →</a>
    </div>
    <div class="category-grid">
      {visibleCategories.map(({ category, count, subcategories }) => <CategoryCard category={category} count={count} subcategories={subcategories} />)}
    </div>
  </section>

  <section class="container recent">
    <div class="section-head">
      <div><p class="eyebrow">Recent notes</p><h2>최근 기록</h2></div>
      <a href="/posts">전체 글 보기 →</a>
    </div>
    <div>{posts.slice(0, 4).map(post => <PostCard post={post} />)}</div>
  </section>

  <section class="container principles">
    <p class="eyebrow">How I write</p>
    <div class="principle-grid">
      <div><strong>01</strong><h3>현상을 재현합니다</h3><p>증상과 환경을 분리해 누구나 같은 문제를 확인할 수 있게 합니다.</p></div>
      <div><strong>02</strong><h3>원인과 대안을 비교합니다</h3><p>동작 원리를 추적하고 선택지마다 생기는 트레이드오프를 기록합니다.</p></div>
      <div><strong>03</strong><h3>검증 범위를 밝힙니다</h3><p>테스트한 것과 아직 확인하지 못한 것을 구분해 결과의 신뢰도를 남깁니다.</p></div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { min-height: 520px; display: grid; grid-template-columns: 1.6fr .7fr; align-items: center; gap: 70px; }
  .hero > * { min-width: 0; }
  h1 { margin: 18px 0 0; font-size: clamp(3rem, 7vw, 6.3rem); line-height: 1.02; letter-spacing: -.075em; }
  h1 em { color: var(--accent); font-style: normal; }
  .intro { align-self: center; color: var(--muted); font-size: 16px; }
  .intro p { margin: 0 0 24px; }
  .intro div { display: flex; flex-wrap: wrap; gap: 12px 18px; }
  .intro a { color: var(--text); font-size: 14px; font-weight: 700; }
  .intro .primary-link { color: var(--accent); }
  .explore { margin-bottom: 100px; }
  .category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 18px; }
  .section-head h2 { margin: 5px 0; font-size: 2rem; }
  .section-head > a { color: var(--accent); font-size: 14px; font-weight: 700; }
  .principles { margin-top: 120px; padding: 54px; background: var(--surface); border: 1px solid var(--line); border-radius: 28px; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 30px; }
  .principle-grid strong { color: var(--accent); font-size: 13px; }
  .principle-grid h3 { margin: 12px 0 8px; letter-spacing: -.03em; }
  .principle-grid p { margin: 0; color: var(--muted); font-size: 14px; }
  @media (max-width: 760px) {
    .hero { min-height: 480px; display: block; padding-top: 72px; }
    h1 { font-size: clamp(2.65rem, 13vw, 4rem); overflow-wrap: anywhere; line-height: 1.06; }
    .intro { margin-top: 36px; }
    .category-grid { grid-template-columns: 1fr; }
    .section-head { align-items: flex-start; flex-direction: column; gap: 6px; }
    .principles { padding: 32px 24px; }
    .principle-grid { grid-template-columns: 1fr; }
  }
</style>
