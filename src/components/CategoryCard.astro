---
interface Props {
  category: { slug: string; name: string; description: string };
  count: number;
  subcategories: { slug: string; name: string; count: number }[];
}

const { category, count, subcategories } = Astro.props;
---
<article class="category-card">
  <span>{String(count).padStart(2, '0')} posts</span>
  <h3><a href={`/categories/${category.slug}/`}>{category.name}</a></h3>
  <p>{category.description}</p>
  <div class="subcategories" aria-label={`${category.name} 세부 주제`}>
    {subcategories.map(subcategory => (
      <a href={`/categories/${category.slug}/${subcategory.slug}/`}>
        <span>{subcategory.name}</span><strong>{subcategory.count}</strong>
      </a>
    ))}
  </div>
  <a class="more" href={`/categories/${category.slug}/`}>전체 글 모아보기 <span aria-hidden="true">→</span></a>
</article>
<style>
  .category-card { display: flex; min-width: 0; min-height: 220px; flex-direction: column; padding: 28px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); transition: transform .2s, border-color .2s; }
  .category-card:hover { transform: translateY(-3px); border-color: var(--accent); }
  .category-card > span { color: var(--accent); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  h3 { margin: 18px 0 8px; overflow-wrap: anywhere; font-size: 1.3rem; line-height: 1.3; letter-spacing: -.035em; }
  h3 a:hover { color: var(--accent); }
  p { margin: 0 0 22px; color: var(--muted); font-size: 14px; }
  .subcategories { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 22px; }
  .subcategories a { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 12px; font-weight: 700; }
  .subcategories a:hover { border-color: var(--accent); color: var(--accent); }
  .subcategories strong { color: var(--accent); font-size: 11px; }
  .more { margin-top: auto; color: var(--accent); font-size: 13px; font-weight: 800; }
  @media (max-width: 760px) { .category-card { min-height: 0; } }
</style>

