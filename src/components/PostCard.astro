---
interface Props {
  post: any;
}
import { getCategoryByName, getCategoryPath, getSubcategoryByName } from '../data/categories';
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const category = getCategoryByName(post.data.category);
const subcategory = getSubcategoryByName(post.data.category, post.data.subcategory);
---
<article class="post-card">
  <div class="meta"><time datetime={post.data.pubDate.toISOString()}>{date}</time><span>·</span>{category && <a href={getCategoryPath(category.name)}>{category.name}</a>}{subcategory && <><span>›</span><a href={getCategoryPath(category?.name ?? '', subcategory.name)}>{subcategory.name}</a></>}</div>
  <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <div class="tags">{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div>
</article>
<style>
  .post-card { padding: 30px 0; border-top: 1px solid var(--line); }
  .meta { display: flex; flex-wrap: wrap; gap: 5px 9px; color: var(--muted); font-size: 13px; }
  .meta a { color: var(--accent); font-weight: 700; }
  h2 { margin: 10px 0 6px; overflow-wrap: anywhere; font-size: clamp(1.35rem, 3vw, 1.8rem); line-height: 1.35; letter-spacing: -.035em; }
  h2 a:hover { color: var(--accent); }
  p { margin: 0 0 16px; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }
</style>
